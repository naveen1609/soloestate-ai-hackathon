APP_NAME="SoloEstate AI"
# Obtain a key from https://dev.meta.ai/ and keep it server-side.
MODEL_API_KEY=
MODEL_NAME=muse-spark-1.3
MODEL_TIMEOUT_SECONDS=30
# Copy the PostgreSQL URI from Supabase Connect (direct or session pooler).
# This is a database password connection, not a Supabase API key or project URL.
DATABASE_URL=
# Optional separate admin connection for migrations; otherwise DATABASE_URL is used.
MIGRATION_DATABASE_URL=
DATABASE_SSLMODE=verify-full
# Absolute path to the CA certificate downloaded from your Supabase project.
DATABASE_SSLROOTCERT=
# Bounded agent execution; defaults work for the fictional demo.
AGENT_MAX_TURNS=12
AGENT_MAX_TOOL_CALLS=16
AGENT_MAX_FAILURES=3
AGENT_TIMEOUT_SECONDS=180
# Generate locally: python -m scripts.owner init. Never expose with NEXT_PUBLIC_.
OWNER_API_TOKEN=
