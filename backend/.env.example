APP_NAME="SoloEstate AI"
# Obtain a key from https://dev.meta.ai/ and keep it server-side.
MODEL_API_KEY=
MODEL_NAME=muse-spark-1.3
MODEL_TIMEOUT_SECONDS=30
# Copy the PostgreSQL URI from Supabase Connect (direct or session pooler).
# This is a database password connection, not a Supabase API key or project URL.
DATABASE_URL=
# Optional separate admin connection for migrations; otherwise DATABASE_URL is used.
MIGRATION_DATABASE_URL=
DATABASE_SSLMODE=verify-full
# Absolute path to the CA certificate downloaded from your Supabase project.
DATABASE_SSLROOTCERT=
# Bounded agent execution; defaults work for the fictional demo.
AGENT_MAX_TURNS=12
AGENT_MAX_TOOL_CALLS=16
AGENT_MAX_FAILURES=3
AGENT_TIMEOUT_SECONDS=180
# Generate locally: python -m scripts.owner init. Never expose with NEXT_PUBLIC_.
OWNER_API_TOKEN=
# Website-chat visitor token HMAC secret. Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(32))" — store only in ignored backend/.env, never in this example; never commit, log or share it. All /chat endpoints fail closed without a configured secret.
VISITOR_TOKEN_SECRET=
# WhatsApp Cloud API (server-only). Webhook verification fails closed without
# WHATSAPP_VERIFY_TOKEN and WHATSAPP_APP_SECRET; outbound driving waits without
# WHATSAPP_ACCESS_TOKEN and WHATSAPP_PHONE_NUMBER_ID. Copy the IDs from the
# Meta app dashboard; never commit, log, or expose these values.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional Graph API base override (default pins the configured version).
WHATSAPP_API_BASE=
WHATSAPP_MOCK_PROVIDER=false
